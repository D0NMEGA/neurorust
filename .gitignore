/target
**/*.rs.bk
.DS_Store
# Donny workflow's own append-only phase-execution event log (timestamps of
# phase_start/etc.), not project documentation; regenerated per session.
.planning/phases/*/*-LEDGER.jsonl
# insta's own pending-review artifact when a snapshot test fails; regenerated
# on every red run, never something to commit.
**/*.snap.new

# Agent operating instructions: local only, never published.
CLAUDE.md

# Written by scripts/nr-push-to-rig.sh so a build on a machine with no git checkout can still
# record which revision it was built from (git_sha_source: pushed-stamp). Machine-local, and
# committing it would make a stale revision look like a tracked fact.
/.git-sha
