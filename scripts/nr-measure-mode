#!/bin/bash
# nr-measure-mode {on|off|status}
#
# Puts the reference rig into, or out of, the state docs/measurement-protocol.md
# requires. Everything it changes is reversible with `off`, and `status` reports
# the live values rather than what any service claims about itself.
#
# Why this exists as one command rather than a list in a document: the protocol
# prep was being applied by hand, and on 2026-09-01 two separate runs were lost
# to prep mistakes. snapd was stopped rather than masked and came straight back
# through socket activation; the governor was assumed to be `performance`
# because rt-tuning.service reported healthy, while power-profiles-daemon had
# silently overwritten it.
#
# The timers matter for long runs. sysstat-collect fires every ten minutes, so
# it lands roughly six times inside a one-hour capture and two dozen times
# inside the four-hour PLAT-03 headline run. fstrim and e2scrub_all are weekly
# but would be severe if they landed mid-run. None of this is visible to the
# D-06 preconditions, which are asserted once at start and cannot see a timer
# that fires at minute forty.
set -u

SERVICES=(power-profiles-daemon.service snapd.service snapd.socket)
TIMERS=(
    sysstat-collect.timer anacron.timer fwupd-refresh.timer
    apt-daily.timer apt-daily-upgrade.timer motd-news.timer
    update-notifier-download.timer update-notifier-motd.timer
    man-db.timer logrotate.timer dpkg-db-backup.timer
    systemd-tmpfiles-clean.timer e2scrub_all.timer fstrim.timer
    sysstat-rotate.timer sysstat-summary.timer apport-autoreport.timer
)

need_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "nr-measure-mode: must run as root" >&2
        exit 2
    fi
}

governors() { cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor 2>/dev/null | sort -u | tr '\n' ' '; }

case "${1:-status}" in
on)
    need_root
    systemctl mask --now "${SERVICES[@]}" >/dev/null 2>&1
    systemctl mask --now "${TIMERS[@]}" >/dev/null 2>&1
    systemctl stop unattended-upgrades.service >/dev/null 2>&1
    systemctl restart rt-tuning.service >/dev/null 2>&1
    # rt-tuning.service is the intended writer, but verify rather than trust it.
    if [ "$(governors)" != "performance " ]; then
        for c in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
            echo performance > "$c" 2>/dev/null
        done
    fi
    echo nop > /sys/kernel/tracing/current_tracer 2>/dev/null
    # Make hwlatdetect able to sample the isolated cores at all.
    #
    # hwlat_detector/mode defaults to `none`, in which the tracer never migrates its
    # kernel thread: it samples whichever CPU the scheduler has it on. isolcpus=6-11
    # removes those CPUs from automatic scheduler placement, so in `none` mode the
    # thread can never land there and hwlatdetect structurally cannot measure the cores
    # this rig exists to characterise. That is not a theory: on 2026-09-05 all 17 events
    # across two D-18 arms named CPU 5, including the arm that passed --cpu-list 0-11,
    # and the 2026-08-28 baseline's P-core arm put all 13 of its events on CPU 0.
    # hwlatdetect itself never writes this file, so nothing else was going to set it.
    # `round-robin` migrates the thread across tracing_cpumask each window.
    # See docs/rig/firmware-floor-rt-vs-stock.md.
    echo round-robin > /sys/kernel/tracing/hwlat_detector/mode 2>/dev/null
    # Reset the mask too. hwlatdetect writes tracing_cpumask when given --cpu-list and
    # never restores it, so without this an unrestricted run silently inherits the last
    # restricted run's mask and samples fewer CPUs than its own output claims. Putting
    # the rig into protocol state means putting this into a known state, not the state
    # the previous capture happened to leave.
    #
    # nproc --all, not nproc: plain nproc reports only the CPUs in the caller's affinity
    # mask, and isolcpus=6-11 removes those six from it. It returns 16 here, which would
    # build a 0xffff mask covering CPUs 0-15 and silently drop 16-21 while looking
    # deliberate. Observed on 2026-09-05 before this comment existed.
    printf '%x\n' $(( (1 << $(nproc --all)) - 1 )) > /sys/kernel/tracing/tracing_cpumask 2>/dev/null
    systemctl set-default multi-user.target >/dev/null 2>&1
    # set-default only changes what the NEXT boot does. Without isolate, gdm keeps
    # running and DisplayManagerInactive/NoGraphicalSession still fail, while status
    # reports multi-user.target and looks correct. That gap cost a scheduled run on
    # 2026-09-03.
    systemctl isolate multi-user.target >/dev/null 2>&1
    # Stop the machine putting itself to sleep. This is a laptop: the default
    # HandleLidSwitch=suspend means a closed lid ends a run outright, and the
    # PLAT-03 headline capture in plan 01-13 runs four hours unattended. Masking
    # the sleep targets is the blunt version and covers idle, lid and manual
    # suspend in one go.
    systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target >/dev/null 2>&1
    echo "measurement mode ON (run 'nr-measure-mode off' to restore the desktop)"
    "$0" status
    ;;
off)
    need_root
    systemctl set-default graphical.target >/dev/null 2>&1
    systemctl unmask sleep.target suspend.target hibernate.target hybrid-sleep.target >/dev/null 2>&1
    systemctl unmask "${TIMERS[@]}" >/dev/null 2>&1
    systemctl unmask "${SERVICES[@]}" >/dev/null 2>&1
    systemctl start power-profiles-daemon.service snapd.socket >/dev/null 2>&1
    echo none > /sys/kernel/tracing/hwlat_detector/mode 2>/dev/null
    # hwlatdetect writes tracing_cpumask when given --cpu-list and never restores it,
    # so a later run inherits the previous run's mask. Put it back to every CPU.
    printf '%x\n' $(( (1 << $(nproc --all)) - 1 )) > /sys/kernel/tracing/tracing_cpumask 2>/dev/null
    systemctl isolate graphical.target >/dev/null 2>&1
    echo "measurement mode OFF, desktop configuration restored"
    "$0" status
    ;;
status)
    printf 'governor        : %s\n' "$(governors)"
    printf 'no_turbo        : %s\n' "$(cat /sys/devices/system/cpu/intel_pstate/no_turbo 2>/dev/null || echo unavailable)"
    printf 'package temp    : %s C\n' "$(awk '{printf "%.1f",$1/1000}' /sys/class/thermal/thermal_zone0/temp 2>/dev/null)"
    printf 'default target  : %s\n' "$(systemctl get-default 2>/dev/null)"
    printf 'ACTIVE target   : %s\n' "$(systemctl is-active graphical.target >/dev/null 2>&1 && echo graphical.target || echo multi-user.target)"
    printf 'display manager : %s\n' "$(systemctl is-active gdm.service 2>&1)"
    printf 'ppd             : %s\n' "$(systemctl is-enabled power-profiles-daemon.service 2>&1)"
    printf 'snapd           : %s\n' "$(systemctl is-enabled snapd.socket 2>&1)"
    printf 'hwlat mode      : %s\n' "$(sed -n 's/.*\[\([a-z-]*\)\].*/\1/p' /sys/kernel/tracing/hwlat_detector/mode 2>/dev/null || echo 'unreadable (needs root)')"
    printf 'tracing_cpumask : %s\n' "$(cat /sys/kernel/tracing/tracing_cpumask 2>/dev/null || echo 'unreadable (needs root)')"
    masked=0
    for t in "${TIMERS[@]}"; do
        [ "$(systemctl is-enabled "$t" 2>&1)" = "masked" ] && masked=$((masked+1))
    done
    printf 'timers masked   : %d of %d\n' "$masked" "${#TIMERS[@]}"
    printf 'suspend blocked : %s\n' "$(systemctl is-enabled sleep.target 2>&1)"
    printf 'ac power        : %s\n' "$(cat /sys/class/power_supply/AC*/online 2>/dev/null | head -1)"
    ;;
*)
    echo "usage: nr-measure-mode {on|off|status}" >&2
    exit 2
    ;;
esac
